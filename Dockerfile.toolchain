# Isolated PHP/TypePHP compiler, never installs PHP on the host.
ARG PHP_VARIANT=cli
FROM php:8.5-${PHP_VARIANT}-bookworm

ARG TYPEPHP_VERSION=0.10.1
ENV COMPOSER_ALLOW_SUPERUSER=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      autoconf bison build-essential ca-certificates cmake curl git \
      libgmp-dev libmpfr-dev libonig-dev libssl-dev libxml2-dev \
      pkg-config python3 re2c unzip zlib1g-dev \
 && docker-php-ext-install -j"$(nproc)" mbstring gmp \
 && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN mkdir -p /opt/typephp \
 && cd /opt/typephp \
 && composer require --no-interaction --no-progress --prefer-dist "swoole/typephp:${TYPEPHP_VERSION}" \
 && php vendor/bin/tpc.php --help >/dev/null

COPY scripts/prepare-swoole-source.py /opt/spechmedia/prepare-swoole-source.py

COPY scripts/install-audio-extensions.sh scripts/install-toolchain-extensions.sh scripts/toolchain-options.sh scripts/typephp-extensions.patch /opt/spechmedia/

ARG EXTRA_EXTENSIONS=""
RUN bash /opt/spechmedia/install-toolchain-extensions.sh $EXTRA_EXTENSIONS
LABEL spechmedia.extensions="$EXTRA_EXTENSIONS"

WORKDIR /workspace
